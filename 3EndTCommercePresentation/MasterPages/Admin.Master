<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Admin.master.cs" Inherits="_3EndTCommercePresentation.MasterPages.Admin" %>



<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title>Administrator</title>
    <link href="/css/admin.css" rel="stylesheet" />
    <script type='text/javascript' src='/js/jquery.min.js'></script>
    <script src="/js/custom.js"></script>

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
       
        <div>
           <div style="overflow:hidden">
                <div  style="height: 50px; text-align: center; font-size: x-large; width:80%; float:left">
                    Admin Control Panel
                </div>
          <div style="width:20%;overflow:hidden;margin-top:5px;">
               <asp:LoginStatus CssClass="logout" ID="MainLoginStatus" LogoutAction="Redirect" LogoutPageUrl ="/Default.aspx" runat="server" LoginText="&nbsp;Login&nbsp;" LogoutText="&nbsp;Logout&nbsp;"  />
          </div>
               </div>
            <div class="divadminleft">


                <div>
                    Company Management                 

                    <div>
                        <asp:HyperLink ID="hlManageTier" NavigateUrl="/Admin/ManageTier.aspx" runat="server">Manage Tier</asp:HyperLink>
                    </div>
                    <div>
                        <asp:HyperLink ID="hlManageCompany" NavigateUrl="/Admin/ManageCompany.aspx" runat="server">Manage Company</asp:HyperLink>
                    </div>
                    <div>
                        <asp:HyperLink ID="hLnkManageTireProduct" NavigateUrl="~/Admin/ManageCompanyShippingAddress.aspx" runat="server">Manage Company Shipping Address</asp:HyperLink>
                    </div>
                    <div>
                        <asp:HyperLink ID="hlManagerCustomer" NavigateUrl="~/Admin/ManageCustomer.aspx" runat="server">Manage Customer</asp:HyperLink>
                    </div>

                </div>
                <div>
                    Product Management
                                       <div>
                                           <asp:HyperLink ID="hlManageCategory" NavigateUrl="~/Admin/ManageProductCategory.aspx" runat="server">Manage Category</asp:HyperLink>
                                       </div>
                    <div>
                        <asp:HyperLink ID="hlManageProduct" NavigateUrl="~/Admin/ManageProduct.aspx" runat="server">Manage Product</asp:HyperLink>
                    </div>

                    <div>
                        <asp:HyperLink ID="hlManageProductItem" NavigateUrl="~/Admin/ManageProductItem.aspx" runat="server">Manage Product Item</asp:HyperLink>
                    </div>
                     <div>
                        <asp:HyperLink ID="hlManageProductItemPrices" NavigateUrl="~/Admin/ManageProductItemPrice.aspx" runat="server">Manage Product Prices</asp:HyperLink>
                    </div>
                                         <div>
                        <asp:HyperLink ID="hlManageDocuments" NavigateUrl="~/Admin/ManageDocuments.aspx" runat="server">Manage Documents</asp:HyperLink>
                    </div>
                </div>
                <%--<div>
                    Customer
                    <div>Manage Customer Tier</div>
                    
                    <div>
                        <asp:HyperLink ID="HyperLink1" NavigateUrl="~/Admin/ManageCustomerTierProductPrice.aspx" runat="server">Manage Customer Price</asp:HyperLink>
                    </div>
                </div>--%>
                <div style="margin-bottom: 10px; text-align: left;">
                    Promotions

                    <div>Add Coupons</div>
                </div>
                <div>Dashboard</div>
                <div>
                    Sales
                    <div>Order</div>
                    <div>Invoice</div>
                    <div>Shipment</div>
                    <div>Transaction</div>
                </div>
                <div style="margin-bottom: 10px; text-align: left;">
                    Reports
                    <div>Sales</div>
                    <div>Shopping Cart</div>
                    <div>Products</div>
                    <div>Customers</div>
                </div>
            </div>
            <div class="divadminright">
                <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                </asp:ContentPlaceHolder>
            </div>


        </div>

    </form>
</body>
</html>
