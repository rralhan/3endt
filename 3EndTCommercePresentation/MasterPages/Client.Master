    <link type="text/css" rel="stylesheet" href="/vendors/bootstrap/css/bootstrap.min.css" />
    <!--LOADING STYLESHEET FOR PAGE-->
    <link type="text/css" rel="stylesheet" href="/vendors/jplist/html/css/jplist-custom.css" />
    <!--Loading style vendors-->
    <link type="text/css" rel="stylesheet" href="/vendors/animate.css/animate.css" />
    <link type="text/css" rel="stylesheet" href="/vendors/jquery-pace/pace.css" />
    <link type="text/css" rel="stylesheet" href="/vendors/iCheck/skins/all.css" />
    <link type="text/css" rel="stylesheet" href="/vendors/jquery-notific8/jquery.notific8.min.css" />
    <link type="text/css" rel="stylesheet" href="/vendors/bootstrap-daterangepicker/daterangepicker-bs3.css" />
    <!--Loading style-->
    <link type="text/css" rel="stylesheet" href="/css1/themes/style1/orange-blue.css" class="default-style" />
    <link type="text/css" rel="stylesheet" href="/css1/themes/style1/orange-blue.css" id="theme_change"
        class="style-change color-change" />
    <link type="text/css" rel="stylesheet" href="/css1/style-responsive.css" />

    <asp:ContentPlaceHolder ID="ContentPlaceHolder2" runat="server">
    </asp:ContentPlaceHolder>
</head>

<body>
    <form id="form1" runat="server">
        <div>

            <!--BEGIN BACK TO TOP-->
            <a id="totop" href="#"><i class="fa fa-angle-up"></i></a>
            <!--END BACK TO TOP-->
            <!--BEGIN TOPBAR-->
            <div id="header-topbar-option-demo" class="page-header-topbar">
                <nav id="topbar" role="navigation" style="margin-bottom: 0; z-index: 2;"
                    class="navbar navbar-default navbar-static-top">
                    <div class="navbar-header">
                        <button type="button" data-toggle="collapse" data-target=".sidebar-collapse" class="navbar-toggle">
                            <span
                                class="sr-only">Toggle navigation</span><span class="icon-bar"></span><span
                                    class="icon-bar"></span><span class="icon-bar"></span></button>
                        <a id="logo" href="../Default.aspx">
                            <img src="../images/logo.jpg" alt="3endt" style="height: 100%" /></a>
                    </div>
                    <div class="topbar-main">
                        <a id="menu-toggle" href="#" class="hidden-xs"><i class="fa fa-bars"></i></a>
                        <ul class="nav navbar navbar-top-links navbar-right mbn">
                            <li><a href="tel:2814702010"><i class="fa fa-phone"></i>&nbsp;281-470-2010</a>
                            </li>
                            <li><a href="https://www.facebook.com/3endt"><i class="fa fa-facebook"></i></a>
                            </li>
                            <li><a href="https://www.twitter.com/3endt"><i class="fa fa-twitter"></i></a>
                            </li>
                            <li><a href="https://www.linkedin.com/company/3endt"><i class="fa fa-linkedin"></i></a>
                            </li>
                        </ul>
                    </div>
                </nav>
            </div>
            <!--END TOPBAR-->
            <div id="wrapper">
                <!--BEGIN SIDEBAR MENU-->
                <asp:HiddenField ID="hdnNav" runat="server" />
                <nav id="sidebar" role="navigation" class="navbar-default navbar-static-side">
                    <div class="sidebar-collapse menu-scroll">
                        <ul id="side-menu" class="nav">
                            <li>
                                <div class="clearfix"></div>
                            </li>
                            <li class="active"><a href="../Default.aspx"><i class="fa fa-radiation fa-fw">
                                <div class="icon-bg bg-orange"></div>
                            </i><span class="menu-title">Home</span></a></li>
                            <li><a href="#"><i class="fa fa-radiation fa-fw">
                                <div class="icon-bg bg-red"></div>
                            </i><span class="menu-title">PRODUCTS</span><span class="fa arrow"></span></a>
                                <%--<ul class="nav nav-second-level">--%>
                                <asp:Literal ID="ltProductItems" runat="server" />
                                <%--</ul>--%>
                            </li>
                            <li><a href="#"><i class="fa fa-radiation fa-fw">
                                <div class="icon-bg bg-red"></div>
                            </i><span class="menu-title">SERVICES</span><span class="fa arrow"></span></a>
                                <%--<ul class="nav nav-second-level">--%>
                                <asp:Literal ID="ltServiceItems" runat="server" />
                                <%--</ul>--%>
                            </li>
                            <li><a href="/client/about-us.aspx"><i class="fa fa-radiation fa-fw">
                                <div class="icon-bg bg-yellow"></div>
                            </i><span class="menu-title">ABOUT US</span></a>
                            </li>
                            <li><a href="/client/contact-us.aspx"><i class="fa fa-radiation fa-fw">
                                <div class="icon-bg bg-yellow"></div>
                            </i><span class="menu-title">CONTACT US</span></a>
                            </li>
                            <!--li.charts-sum<div id="ajax-loaded-data-sidebar"></div>-->
                        </ul>
                    </div>
                </nav>
                <!--END SIDEBAR MENU-->
                <!--BEGIN PAGE WRAPPER-->
                <asp:ContentPlaceHolder ID="CoreContentHolder" runat="server">
                </asp:ContentPlaceHolder>
                <!--BEGIN FOOTER-->
                <div id="footer">
                    <center>
                    <h4>High Quality NDT Equipment</h4>
                    <div class="copyright">Copyright 2017 | 3endt. All rights reserved.</div>
                        </center>
                </div>
                <!--END FOOTER-->
                <!--END PAGE WRAPPER-->
