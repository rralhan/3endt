<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Client.master.cs" Inherits="_3EndTCommercePresentation.MasterPages.Client" %>

<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
